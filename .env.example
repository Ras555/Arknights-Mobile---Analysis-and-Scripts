# Copy this file to .env and fill in real values. .env is gitignored.

# Yostar EN account email used by the roster step to log in. A login code
# is emailed to this address and arkprts asks for it in the console.
USER_EMAIL=

# Optional settings (defaults shown). Uncomment to change them.
# HellaAPI base URL:
# HELLA_API_URL=https://awedtan.ca/api
# Longest the HellaAPI cache (ref/cache) goes without checking for changed data, in days:
# HELLA_CACHE_DAYS=14
# How old the saved roster can be before stats/matchups suggest `arknights-calc roster`, in days:
# ROSTER_MAX_AGE_DAYS=7
